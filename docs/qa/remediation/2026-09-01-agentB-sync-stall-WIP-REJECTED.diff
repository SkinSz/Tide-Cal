 describe("DC-05 §6: Noise encrypted transport", () => {
+  // Sync-stall fix (QA root-cause report, amplifier defect): an in-memory
+  // FramedByteTransport pair so handshakeOverTransport's carrier→inbound feed
+  // loop is exercised, including the peer-FIN (receive() === null) path.
+  class MemCarrier implements FramedByteTransport {
+    private q: Uint8Array[] = [];
+    private waiter: ((f: Uint8Array | null) => void) | null = null;
+    private isClosed = false;
+    private peer: MemCarrier | null = null;
+
+    static pair(): [MemCarrier, MemCarrier] {
+      const a = new MemCarrier();
+      const b = new MemCarrier();
+      a.peer = b;
+      b.peer = a;
+      return [a, b];
+    }
+
+    send(frame: Uint8Array): Promise<void> {
+      if (this.isClosed || this.peer?.isClosed) throw new Error("carrier closed");
+      this.peer!.deliver(frame);
+      return Promise.resolve();
+    }
+
+    private deliver(frame: Uint8Array): void {
+      if (this.isClosed) return;
+      if (this.waiter !== null) {
+        const w = this.waiter;
+        this.waiter = null;
+        w(frame);
+        return;
+      }
+      this.q.push(frame);
+    }
+
+    receive(): Promise<Uint8Array | null> {
+      const next = this.q.shift();
+      if (next !== undefined) return Promise.resolve(next);
+      if (this.isClosed) return Promise.resolve(null);
+      return new Promise((resolve) => {
+        this.waiter = resolve;
+      });
+    }
+
+    close(): void {
+      this.isClosed = true;
+      if (this.waiter !== null) {
+        const w = this.waiter;
+        this.waiter = null;
+        w(null);
+      }
+    }
+  }
+
+  test("peer FIN on the carrier propagates as clean EOF (null) on the session's inbound queue", { timeout: 120000 }, async () => {
+    const [carrierA, carrierB] = MemCarrier.pair();
+    const [sessionA] = await Promise.all([
+      handshakeOverTransport("initiator", carrierA, new Uint8Array(32).fill(1)),
+      handshakeOverTransport("responder", carrierB, new Uint8Array(32).fill(2)),
+    ]);
+
+    // A waiter is parked on the inbound queue when the peer's carrier closes:
+    // the feed loop must call inbound.close() so the receive resolves null
+    // (clean EOF) instead of pending forever. Before the fix this receive
+    // never resolved — the engine's clean-EOF handling was unreachable and
+    // every peer close surfaced as a 15 s SyncIdleTimeoutError.
+    const parked = sessionA.inbound.receive();
+    carrierB.close();
+    expect(await parked).toBeNull();
+    // Subsequent receives also resolve null (queue closed), never hang.
+    expect(await sessionA.inbound.receive()).toBeNull();
+  });
+
